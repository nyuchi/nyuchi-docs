---
// Starlight component override. Renders the search trigger on the server and
// loads the framework-free modal in the browser. Configuration comes from
// PUBLIC_ env vars (so the site that consumes the package can set it) and is
// handed to the script as data attributes.
const aiUrl = (import.meta.env.PUBLIC_SHAMWARI_AI_URL as string | undefined) ?? '';
const sourceRaw = (import.meta.env.PUBLIC_DOCS_SOURCE as string | undefined) ?? '';
const source = sourceRaw === 'bundu' || sourceRaw === 'nyuchi' ? sourceRaw : '';
---

<button
  type="button"
  class="nds-trigger"
  data-nds-trigger
  data-ai-url={aiUrl}
  data-source={source}
  aria-label="Search docs"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-keyshortcuts="Control+K Meta+K"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M11 19a8 8 0 1 1 5.3-14.02A8 8 0 0 1 11 19zm10 2-4.35-4.35"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <span>Search</span>
  <kbd>⌘K</kbd>
</button>

<script>
  import { initDocsSearch } from './lib/search-modal.js';

  initDocsSearch();
</script>

<style is:global>
  .nds-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5, #2c2c2c);
    background: var(--sl-color-bg-nav, #1a1a1a);
    color: var(--sl-color-gray-2, #c0c0c0);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .nds-trigger:hover {
    border-color: var(--mzizi-green, #00875a);
  }
  .nds-trigger kbd,
  .nds-esc {
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: var(--sl-color-gray-6, #1a1a1a);
    border: 1px solid var(--sl-color-gray-5, #2c2c2c);
  }
  .nds-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 6rem 1rem 1rem;
    z-index: 9999;
    backdrop-filter: blur(4px);
  }
  .nds-overlay[hidden],
  .nds-panel[hidden],
  .nds-error[hidden] {
    display: none;
  }
  .nds-modal {
    width: 100%;
    max-width: 640px;
    background: var(--sl-color-bg, #0f0f0f);
    border: 1px solid var(--sl-color-gray-5, #2c2c2c);
    border-radius: 0.75rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }
  .nds-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5, #2c2c2c);
    color: var(--sl-color-gray-3, #a0a0a0);
  }
  .nds-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--sl-color-white, #fff);
    font-size: 1rem;
  }
  .nds-input-row:focus-within {
    box-shadow: inset 0 -2px 0 var(--mzizi-green, #00875a);
  }
  .nds-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5, #2c2c2c);
  }
  .nds-tab {
    padding: 0.45rem 0.85rem;
    background: transparent;
    border: none;
    color: var(--sl-color-gray-3, #a0a0a0);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .nds-tab.active {
    color: var(--mzizi-green, #00875a);
    border-bottom-color: var(--mzizi-green, #00875a);
  }
  .nds-body {
    flex: 1;
    overflow-y: auto;
  }
  .nds-results {
    padding: 0.5rem 0;
  }
  .nds-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nds-result {
    display: block;
    padding: 0.6rem 1rem;
    color: inherit;
    text-decoration: none;
    border-left: 3px solid transparent;
  }
  .nds-result.selected,
  .nds-result:hover {
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.04));
    border-left-color: var(--mzizi-green, #00875a);
  }
  .nds-result-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .nds-result-title {
    font-weight: 600;
    color: var(--sl-color-white, #fff);
  }
  .nds-result-crumb {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3, #a0a0a0);
  }
  .nds-result-snippet {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2, #c0c0c0);
    line-height: 1.4;
  }
  .nds-empty {
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--sl-color-gray-3, #a0a0a0);
    font-size: 0.9rem;
    margin: 0;
  }
  .nds-chat {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 320px;
  }
  .nds-thread {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .nds-msg {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nds-role {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3, #a0a0a0);
  }
  .nds-content {
    white-space: pre-wrap;
    color: var(--sl-color-white, #fff);
    line-height: 1.5;
    font-size: 0.9rem;
  }
  .nds-msg-user .nds-content {
    color: var(--mzizi-green, #00875a);
  }
  .nds-caret {
    opacity: 0.6;
  }
  .nds-error {
    margin: 0;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    color: var(--sl-color-red, #ff6b6b);
  }
  .nds-citations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }
  .nds-citation {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5, #2c2c2c);
    border-radius: 999px;
    background: var(--sl-color-gray-6, #1a1a1a);
    color: var(--sl-color-gray-1, #e0e0e0);
    text-decoration: none;
    font-size: 0.75rem;
    line-height: 1;
  }
  .nds-citation sup {
    color: var(--mzizi-green, #00875a);
    font-weight: 700;
  }
  .nds-citation-crumb {
    color: var(--sl-color-gray-3, #a0a0a0);
  }
  .nds-citation:hover {
    border-color: var(--mzizi-green, #00875a);
  }
  .nds-composer {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5, #2c2c2c);
  }
  .nds-composer-input {
    flex: 1;
    background: var(--sl-color-gray-6, #1a1a1a);
    border: 1px solid var(--sl-color-gray-5, #2c2c2c);
    border-radius: 0.5rem;
    color: inherit;
    padding: 0.5rem 0.6rem;
    resize: none;
    font: inherit;
    font-size: 0.9rem;
  }
  .nds-send {
    padding: 0 1rem;
    background: var(--mzizi-green, #00875a);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    font: inherit;
    cursor: pointer;
  }
  .nds-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .nds-tab:focus-visible,
  .nds-send:focus-visible,
  .nds-trigger:focus-visible,
  .nds-citation:focus-visible,
  .nds-composer-input:focus-visible {
    outline: 2px solid var(--mzizi-green, #00875a);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nds-trigger {
      transition: border-color 120ms ease;
    }
    .nds-caret {
      animation: nds-blink 1s steps(2) infinite;
    }
  }
  @keyframes nds-blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    .nds-overlay {
      padding: 0;
    }
    .nds-modal {
      max-width: none;
      width: 100%;
      height: 100%;
      max-height: 100vh;
      border-radius: 0;
    }
  }
</style>
