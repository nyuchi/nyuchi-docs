{
  "name": "@nyuchi/nyuchi-docs-search",
  "version": "0.1.0",
  "description": "Mintlify-style cmdk search modal with Pagefind + Ask-AI for Starlight docs sites (nyuchi-docs, bundu-docs).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyuchi/nyuchi-docs.git",
    "directory": "nyuchi-docs-search"
  },
  "keywords": [
    "starlight",
    "astro",
    "search",
    "cmdk",
    "pagefind",
    "docs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./search-modal": {
      "types": "./dist/lib/search-modal.d.ts",
      "import": "./dist/lib/search-modal.js"
    },
    "./Search.astro": "./dist/Search.astro"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/Search.astro dist/Search.astro && publint",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "check": "vp check --no-fmt",
    "lint": "vp lint",
    "fmt": "vp fmt"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.39.0 || ^0.41.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
