{
  "name": "shamwari-docs-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that proxies the docs Ask-AI tab to Cloudflare AI Search instances (web-crawler corpora) and emits the SSE wire shape the nyuchi-docs-search client consumes.",
  "scripts": {
    "build": "tsc --noEmit && vp build",
    "dev": "vp dev",
    "deploy": "vp build && wrangler deploy -c dist/shamwari_docs_ai/wrangler.json",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check --no-fmt"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
