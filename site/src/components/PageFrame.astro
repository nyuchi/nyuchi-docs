---
/**
 * PageFrame override — the app-core shell. Composes the Mzizi shell frame
 * (Starlight's PageFrame plus the full-width Mzizi footer, from
 * @nyuchi/nyuchi-docs-shell) and adds the fixed 4px VERTICAL seven-mineral
 * strip on the left edge, full viewport height, hidden below 480px.
 *
 * The horizontal seven-mineral strips in the sidebar and footer are part of
 * the standard Mzizi shell (issue #133) and come from the shell package; this
 * page-edge strip is the site's own and stays.
 */
import ShellFrame from '@nyuchi/nyuchi-docs-shell/PageFrame.astro';
---

<div class="mineral-stripe" aria-hidden="true" data-slot="mineral-stripe"></div>
<ShellFrame>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</ShellFrame>

<style>
  .mineral-stripe {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 4px;
    z-index: 9998;
    display: none;
    /* Canonical seven minerals, top to bottom, equal sevenths. */
    background: linear-gradient(
      to bottom,
      var(--color-cobalt) 0% 14.2857%,
      var(--color-tanzanite) 14.2857% 28.5714%,
      var(--color-malachite) 28.5714% 42.8571%,
      var(--color-gold) 42.8571% 57.1428%,
      var(--color-terracotta) 57.1428% 71.4285%,
      var(--color-sodalite) 71.4285% 85.7142%,
      var(--color-copper) 85.7142% 100%
    );
  }
  @media (min-width: 480px) {
    .mineral-stripe {
      display: block;
    }
  }
</style>
