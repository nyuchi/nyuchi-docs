{
  "name": "site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build:deps": "pnpm --filter @nyuchi/nyuchi-docs-search build",
    "generate:internal-paths": "node scripts/generate-internal-paths.mjs",
    "sync:auth-md": "node scripts/sync-auth-md.mjs",
