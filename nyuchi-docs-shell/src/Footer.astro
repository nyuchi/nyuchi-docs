---
/**
 * Mzizi shell footer (anatomy of the registry's `mzizi-footer`): a top
 * border, the 3px seven-mineral strip, a brand column (logo and the line
 * "I am because we are."), link columns with 45px targets, and a legal line.
 *
 * Mounted by PageFrame.astro at body level, not in Starlight's Footer slot
 * (see plugin.ts for why). Being a direct child of <body>, the <footer> is the
 * page's contentinfo landmark.
 */
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import options from 'virtual:nyuchi-docs-shell/options';

const { tagline, legal, footerColumns } = options;
---

<footer class="mzizi-footer print:hidden" data-slot="mzizi-footer">
  <div class="mzizi-strip mzizi-strip--footer" aria-hidden="true" data-slot="mineral-strip"></div>
  <div class="mzizi-footer__inner">
    <div class="mzizi-footer__grid">
      <div class="mzizi-footer__brand">
        <SiteTitle />
        {tagline && <p class="mzizi-footer__tagline">{tagline}</p>}
      </div>
      <div class="mzizi-footer__columns">
      {
        footerColumns.map((column) => (
          <nav class="mzizi-footer__column" aria-label={column.title}>
            <h2 class="mzizi-footer__heading">{column.title}</h2>
            <ul>
              {column.links.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.label}
                    {item.external && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      </div>
    </div>
    {
      legal && (
        <div class="mzizi-footer__legal">
          <p>{legal}</p>
        </div>
      )
    }
  </div>
</footer>
