---
/**
 * Mzizi shell header (anatomy of the registry's `mzizi-header`).
 *
 * Left: the menu button (below 50rem) and the brand (logo + app name, via
 * Starlight's SiteTitle). The button is ours rather than Starlight's
 * MobileMenuToggle (which the plugin blanks): that one is rendered inside the
 * sidebar, after the header, so it would be first on screen but fifth in the
 * tab order. It drives the same popover (`#starlight__sidebar`), so Starlight's
 * focus trap and Escape handling are unchanged.
 * Centre: top-level section links (desktop only).
 * Right: ONE action group. Below 50rem it is the brand-accent pill (a capsule
 * of round icon buttons: search, theme); from 50rem it is the labelled search
 * field, the GitHub icon and the theme select. It is one DOM tree reshaped by
 * CSS, so the search modal has a single trigger and nothing renders twice.
 *
 * Reuses Starlight's Search (the nyuchi-docs-search modal and Ctrl+K),
 * ThemeSelect and SocialIcons, so theme persistence, Pagefind and keyboard
 * behaviour are unchanged. Colours come from tokens only.
 */
import { Icon } from '@astrojs/starlight/components';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import options from 'virtual:nyuchi-docs-shell/options';
import { isActivePath } from './lib/nav.js';

const { navLinks, accent } = options;
const current = Astro.url.pathname;
const { hasSidebar } = Astro.locals.starlightRoute;
const nav = navLinks.map((item) => ({
  ...item,
  active: isActivePath(current, item.href),
}));
// Only emit the accent when it differs from the stylesheet default.
const accentCss =
  accent === 'var(--sl-color-accent)' ? '' : `:root{--mzizi-brand-accent:${accent}}`;
---

{accentCss && <style is:inline set:html={accentCss} />}

<div class="mzizi-header" data-slot="mzizi-header">
  {
    hasSidebar && (
      <button
        type="button"
        popovertarget="starlight__sidebar"
        class="mzizi-menu-button md:sl-hidden print:hidden"
        data-slot="menu-trigger"
      >
        <Icon name="bars" class="open-menu" size="1.25rem" />
        <Icon name="close" class="close-menu" size="1.25rem" />
        <span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
      </button>
    )
  }
  <div class="mzizi-header__brand">
    <SiteTitle />
  </div>

  {
    nav.length > 0 && (
      <nav class="mzizi-header__nav" aria-label="Sections" data-slot="header-nav">
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? 'true' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
                {item.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div
    class="mzizi-actions print:hidden"
    role="toolbar"
    aria-label="Site actions"
    data-slot="pill-actions"
  >
    <div class="mzizi-actions__item mzizi-actions__search"><Search /></div>
    <div class="mzizi-actions__item mzizi-actions__social"><SocialIcons /></div>
    <div class="mzizi-actions__item mzizi-actions__theme"><ThemeSelect /></div>
  </div>
</div>

<script>
  import { initScrollState } from './lib/scroll-state.js';

  initScrollState();
</script>
