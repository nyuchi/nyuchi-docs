---
/**
 * Page frame with the Mzizi footer appended. Starlight's PageFrame owns the
 * fixed header, the sidebar pane (the mobile popover) and the main column;
 * this wraps it unchanged and adds the full-width footer after it, so the
 * footer is a real top-level landmark rather than a block inside the article.
 *
 * A site with its own PageFrame override composes this one:
 *   import ShellFrame from '@nyuchi/nyuchi-docs-shell/PageFrame.astro';
 */
import Default from '@astrojs/starlight/components/PageFrame.astro';
import Footer from './Footer.astro';
---

<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>
<Footer />
