{
  "name": "nyuchi-docs-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dedicated Cloudflare Worker for the docs MCP server (docs.nyuchi.com/mcp) — read tools over the nyuchi-docs AI Search corpus, feedback/issue write tools into KV. The npm stdio bridge lives in ../nyuchi-docs-mcp.",
  "scripts": {
    "build": "tsc --noEmit && vp build",
    "dev": "vp dev",
    "deploy": "vp build && wrangler deploy -c dist/nyuchi_docs_mcp/wrangler.json",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check --no-fmt"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261122.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^8.3.8000",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
